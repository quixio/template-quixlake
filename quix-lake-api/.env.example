# QuixLake Configuration
# Copy this file to .env and fill in your values

# S3 Storage Configuration (REQUIRED)
S3_BUCKET=your-quixlake-bucket
S3_PREFIX=data
AWS_REGION=us-east-1

# Catalog Configuration (OPTIONAL)
# Set to true to store DuckLake catalog in S3, false for local storage
USE_S3_CATALOG=false

# AWS Authentication (OPTIONAL - prefer IAM roles when possible)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Alternative: Use AWS profile instead of explicit credentials
# AWS_PROFILE=your-aws-profile

# API Configuration (OPTIONAL)
FLASK_ENV=production
FLASK_DEBUG=false

# S3 Bucket Structure:
# s3://your-quixlake-bucket/
# ├── data/                    # All table data (S3_PREFIX)
# │   ├── events_hive/
# │   │   ├── machine=3D_PRINTER_0/
# │   │   │   └── experiment_name=test/
# │   │   │       └── data_123.parquet
# │   │   └── machine=3D_PRINTER_1/
# │   │       └── experiment_name=prod/
# │   │           └── data_456.parquet
# │   └── users/
# │       └── data_789.parquet
# └── metadata/                # Catalog (if USE_S3_CATALOG=true)
#     └── catalog.ducklake

# Local Files (always present):
# state/
# ├── duckdb.db              # Local DuckDB instance (if USE_S3_CATALOG=false)
# ├── metadata.ducklake       # Local catalog (if USE_S3_CATALOG=false)
# └── duckdb_swap/           # Temporary files